{
  "name": "obrobka",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --build --force && tsc --noEmit -p apps/web/tsconfig.lib.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "shots": "playwright test --config playwright.shots.config.ts",
    "e2e:prod": "playwright test --config playwright.prod.config.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260820.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.1",
    "onnxruntime-node": "1.27.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  },
  "dependencies": {
    "exifr": "7.1.3"
  }
}
