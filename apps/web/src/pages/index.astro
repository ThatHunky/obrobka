---
import Base from '../layouts/Base.astro';
import Widget from '../components/Widget.svelte';
---
<Base
  title="obrobka — конвертер зображень у браузері"
  description="Конвертація, обрізка та зміна розміру зображень просто в браузері. Файли не залишають ваш пристрій."
  locale="uk"
  path="/"
  alternatePath="/en/"
>
  <h1>Обробка зображень у браузері</h1>
  <p>Файли не залишають ваш пристрій — уся обробка відбувається локально.</p>
  <Widget client:visible />
</Base>
