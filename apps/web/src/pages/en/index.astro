---
import Base from '../../layouts/Base.astro';
import Widget from '../../components/Widget.svelte';
import HeroDemo from '../../components/HeroDemo.astro';
---
<Base
  title="obrobka — in-browser image converter"
  description="Convert, crop and resize images entirely in your browser. Files never leave your device."
  locale="en"
  path="/en/"
  alternatePath="/"
>
  <section class="wrap hero">
    <div class="hero-copy">
      <span class="tag">Nothing is uploaded</span>
      <h1>Exact pixels.<br /><span class="hl">No server.</span></h1>
      <p class="lede">
        Convert, crop and resize images to the dimensions you need, right in the tab.
        Processing runs on your device — the file never travels.
      </p>
      <ul class="facts">
        <li><strong>PNG · JPEG · WebP · AVIF</strong></li>
        <li><strong>5</strong> fitting modes</li>
        <li><strong>0</strong> bytes uploaded</li>
      </ul>
    </div>
    <HeroDemo />
  </section>

  <section class="wrap tool">
    <Widget client:load />
  </section>
</Base>

<style>
  .hero {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  @media (min-width: 56rem) { .hero { grid-template-columns: 1.15fr 0.85fr; } }
  .hero-copy { display: grid; gap: 1.1rem; justify-items: start; }
  h1 .hl {
    background: linear-gradient(105deg, var(--accent) 10%, var(--violet-400) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .facts {
    display: flex; flex-wrap: wrap; gap: 0.5rem 1.6rem;
    list-style: none; padding: 0; margin-top: 0.4rem;
    font-size: 0.9rem; color: var(--fg-muted);
  }
  .facts strong { font-family: var(--font-mono); color: var(--fg); }
  .tool { margin-bottom: clamp(3rem, 8vw, 5rem); }
</style>
