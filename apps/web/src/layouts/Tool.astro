---
import Base from './Base.astro';
import Widget from '../components/Widget.svelte';
import type { CollectionEntry } from 'astro:content';
import { pathOf, type Listed } from '../lib/catalogue.js';

/**
 * Шаблон приймає самі дані, а не запис колекції: сторінки приходять
 * із двох колекцій — написаних руками й породжених, — і шаблону
 * немає діла до того, звідки саме.
 */
interface Props {
  data: CollectionEntry<'tools'>['data'];
  pairSlug: string;
  related: readonly Listed[];
}
const { data: d, pairSlug, related } = Astro.props;

const path = d.locale === 'uk' ? `/${d.slug}/` : `/en/${d.slug}/`;
const alternatePath = d.locale === 'uk' ? `/en/${pairSlug}/` : `/${pairSlug}/`;
const site = 'https://obrobka.dobrovolskyi.com.ua';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SoftwareApplication',
      name: 'obrobka',
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'Any',
      url: `${site}${path}`,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'UAH' },
    },
    {
      '@type': 'HowTo',
      name: d.h1,
      step: d.steps.map((text, i) => ({ '@type': 'HowToStep', position: i + 1, text })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: d.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---
<Base
  title={d.title}
  description={d.description}
  locale={d.locale}
  path={path}
  alternatePath={alternatePath}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <article class="wrap narrow tool-page">
    <header class="tool-head">
      <span class="tag">{d.locale === 'uk' ? 'Працює у вашому браузері' : 'Runs in your browser'}</span>
      <h1>{d.h1}</h1>
      <p class="lede">{d.intro}</p>
    </header>

    <Widget client:load preset={d.preset} locale={d.locale} />

    <section class="steps">
      <h2>{d.locale === 'uk' ? 'Як це зробити' : 'How to do it'}</h2>
      <ol>{d.steps.map((s) => <li>{s}</li>)}</ol>
    </section>

    {related.length > 0 && (
      <section class="related">
        <h2>{d.locale === 'uk' ? 'Поруч' : 'Nearby'}</h2>
        <ul>
          {related.map((r) => <li><a href={pathOf(r)}>{r.h1}</a></li>)}
        </ul>
      </section>
    )}

    <section class="faq">
      <h2>{d.locale === 'uk' ? 'Часті питання' : 'Frequently asked questions'}</h2>
      <dl>
        {d.faq.map((f) => (<><dt>{f.q}</dt><dd>{f.a}</dd></>))}
      </dl>
    </section>
  </article>

</Base>

<style>
  .tool-page { display: grid; gap: clamp(2rem, 5vw, 3rem); }
  .tool-head { display: grid; gap: 0.9rem; justify-items: start; }

  .steps ol {
    counter-reset: s;
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.8rem;
    margin-top: 1rem;
  }
  .steps li {
    counter-increment: s;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    align-items: baseline;
  }
  .steps li::before {
    content: counter(s);
    display: grid;
    place-items: center;
    width: 1.9rem; height: 1.9rem;
    border-radius: 50%;
    background: var(--accent-bg);
    color: var(--accent-fg);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.8rem;
  }

  .faq dl { margin-top: 1rem; display: grid; gap: 0.2rem; }
  .faq dt {
    font-weight: 600;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .faq dt:first-of-type { border-top: 0; margin-top: 0; padding-top: 0; }
  .faq dd { margin: 0.3rem 0 0; color: var(--fg-muted); font-size: 0.95rem; }

  .related ul {
    list-style: none; padding: 0; margin: 1rem 0 0;
    display: flex; flex-wrap: wrap; gap: 0.5rem;
  }
  .related a {
    display: inline-block;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-raised);
    color: inherit;
    text-decoration: none;
    font-size: 0.85rem;
    transition: border-color var(--dur) var(--ease-out);
  }
  .related a:hover { border-color: var(--accent); }
  .all { margin: 0; }
</style>
