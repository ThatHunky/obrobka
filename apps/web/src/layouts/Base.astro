---
import '../styles/base.css';
import { FONT_PRELOAD } from '../lib/fonts.js';

interface Props {
  title: string;
  description: string;
  locale: 'uk' | 'en';
  path: string;
  alternatePath: string;
}
const { title, description, locale, path, alternatePath } = Astro.props;
const site = 'https://obrobka.dobrovolskyi.com.ua';
const other = locale === 'uk' ? 'en' : 'uk';
const defaultPath = locale === 'uk' ? path : alternatePath;
const t = locale === 'uk'
  ? { skip: 'Перейти до вмісту', theme: 'Перемкнути тему',
      tagline: 'Обробка зображень у браузері', privacy: 'Файли не залишають ваш пристрій' }
  : { skip: 'Skip to content', theme: 'Toggle theme',
      tagline: 'In-browser image processing', privacy: 'Files never leave your device' };
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${site}${path}`} />
    <link rel="alternate" hreflang={locale} href={`${site}${path}`} />
    <link rel="alternate" hreflang={other} href={`${site}${alternatePath}`} />
    <link rel="alternate" hreflang="x-default" href={`${site}${defaultPath}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'uk' ? 'uk_UA' : 'en_US'} />
    <meta name="theme-color" content="#0b1020" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f8fc" media="(prefers-color-scheme: light)" />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={`${site}${path}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- SVG першим: сучасні браузери беруть саме його й масштабують без втрат -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/*
      Шрифти лежать у нас, а не в Google.

      Виміряно на продакшені: CSS із fonts.googleapis.com коштував 375 мс
      на два кілобайти — це рукостискання з чужим хостом, і воно блокувало
      показ. Потім починався другий чужий хост, fonts.gstatic.com, зі своїм
      рукостисканням. Наші файли з уже відкритого з'єднання приходили за
      14–16 мс. Заразом зникла дрібна невідповідність: сайт обіцяє, що файл
      не залишає пристрій, а браузер тим часом ходив у Google.

      Підвантажуємо наперед лише Inter — це основний текст, від якого
      залежить перший показ. Заголовковий Unbounded і моноширинний
      приходять звичайним шляхом зі swap.
    */}
    {FONT_PRELOAD.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}

    <!-- Тема застосовується до першого малювання, щоб не було спалаху -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('obrobka-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.dataset.theme = saved;
          }
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>

    <header class="site-head">
      <div class="wrap head-inner">
        <!--
          Без aria-label: тут стояло «Головна», і доступне ім'я посилання
          розходилось із видимим словом «obrobka». Для читача з екрана це
          різні речі, а керування голосом просто не спрацьовує — сказати
          можна лише те, що видно. Видимий текст сам є найкращим іменем.
        -->
        <a href={locale === 'uk' ? '/' : '/en/'} class="brand">
          <span class="brand-mark checker" aria-hidden="true"></span>
          <span class="brand-name">obrobka</span>
        </a>
        <p class="brand-tag">{t.tagline}</p>
        <div class="head-actions">
          <a class="lang" href={alternatePath} hreflang={other} lang={other}>
            {other === 'en' ? 'EN' : 'UK'}
          </a>
          <button type="button" class="theme" id="theme-toggle" aria-label={t.theme}>
            <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4.2" />
              <path d="M12 2v2M12 20v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2 12h2M20 12h2M4.6 19.4 6 18M18 6l1.4-1.4" />
            </svg>
            <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.7 6.7 0 0 0 10.5 10.5z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-foot">
      <div class="wrap foot-inner">
        <p>{t.privacy}</p>
        <a href="https://dobrovolskyi.com.ua" rel="me author">Всеволод Добровольський</a>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const btn = document.getElementById('theme-toggle');
        if (!btn) return;
        btn.addEventListener('click', () => {
          const root = document.documentElement;
          const dark = root.dataset.theme
            ? root.dataset.theme === 'dark'
            : matchMedia('(prefers-color-scheme: dark)').matches;
          const next = dark ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('obrobka-theme', next); } catch {}
        });
      })();
    </script>
  </body>
</html>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(14px) saturate(140%);
    background: color-mix(in oklab, var(--bg) 78%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .head-inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.7rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--fg);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }
  .brand-mark {
    width: 26px; height: 26px;
    border-radius: 7px;
    border: 1px solid var(--line-strong);
    --checker-size: 9px;
    box-shadow: 0 0 0 3px var(--accent-glow);
    transition: transform var(--dur) var(--ease-spring);
  }
  .brand:hover .brand-mark { transform: rotate(-8deg) scale(1.08); }

  .brand-tag {
    font-size: 0.82rem;
    color: var(--fg-faint);
    border-left: 1px solid var(--line);
    padding-left: 1rem;
  }
  @media (max-width: 44rem) { .brand-tag { display: none; } }

  .head-actions { margin-inline-start: auto; display: flex; align-items: center; gap: 0.5rem; }

  .lang, .theme {
    display: inline-grid;
    place-items: center;
    min-width: 36px;
    height: 36px;
    padding-inline: 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-raised);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: color var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out),
                transform var(--dur-fast) var(--ease-spring);
  }
  .lang:hover, .theme:hover { color: var(--fg); border-color: var(--line-strong); transform: translateY(-1px); }

  .theme .i-moon { display: none; }
  :global(:root[data-theme='dark']) .theme .i-sun { display: none; }
  :global(:root[data-theme='dark']) .theme .i-moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme .i-sun { display: none; }
    :global(:root:not([data-theme='light'])) .theme .i-moon { display: block; }
  }

  main { flex: 1; padding-block: clamp(2rem, 6vw, 4.5rem); position: relative; z-index: 1; }

  .site-foot { border-top: 1px solid var(--line); margin-top: 4rem; }
  .foot-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    justify-content: space-between;
    padding-block: 1.6rem;
    font-size: 0.85rem;
    color: var(--fg-faint);
  }
  .foot-inner a { color: var(--fg-muted); text-decoration: none; }
  .foot-inner a:hover { color: var(--accent-text); }
</style>
